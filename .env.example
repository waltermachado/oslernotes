# ATENÇÃO: VITE_SUPABASE_URL deve ser APENAS a URL base do projeto, SEM path.
# O SDK adiciona /auth/v1, /rest/v1 etc. internamente.
# ERRADO: https://<project-ref>.supabase.co/rest/v1  ← quebra autenticação
# CORRETO: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# anon key: formato JWT (eyJ...) ou novo formato Supabase (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=<sua_anon_key_publica>
# URL base para as Supabase Edge Functions (gateway da API) — inclui /functions/v1
VITE_API_BASE_URL=https://<project-ref>.supabase.co/functions/v1

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=

PUBLIC_APP_URL=
CORS_ORIGIN=

MOCKPAY_WEBHOOK_SECRET=
MOCKPAY_RETRY_SECRET=

NEXANO_API_BASE_URL=
NEXANO_API_KEY=
NEXANO_WEBHOOK_SECRET=
NEXANO_RENEWAL_SECRET=

PASSWORD_RESET_MAX_ATTEMPTS=
PASSWORD_RESET_WINDOW_SECONDS=
PASSWORD_RESET_TTL_MINUTES=

ACCESS_LIMITS_FAIL_OPEN=

PORT=
